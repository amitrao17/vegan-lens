{
  "manifest_version": 3,
  "name": "Vegan Lens",
  "version": "0.4.70",
  "description": "Spot vegan and non-vegan products and content as you shop, search and browse, with sourced context and easy vegan swaps.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://world.openfoodfacts.org/*",
    "https://world.openbeautyfacts.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.giantfood.com/*",
        "*://*.stopandshop.com/*",
        "*://*.martinsfoods.com/*",
        "*://*.giantfoodstores.com/*"
      ],
      "js": [
        "brand.js",
        "pageKey.js",
        "rules/rulesData.js",
        "rules/rules.js",
        "share.js",
        "veganBrands.js",
        "classifier.js",
        "swaps.js",
        "adUnits.js",
        "sites.js",
        "offers.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.amazon.com/*",
        "*://*.giantfood.com/*",
        "*://*.stopandshop.com/*",
        "*://*.martinsfoods.com/*",
        "*://*.giantfoodstores.com/*",
        "*://*.facebook.com/marketplace*"
      ],
      "js": [
        "brand.js",
        "pageKey.js",
        "rules/rulesData.js",
        "rules/rules.js",
        "share.js",
        "swaps.js",
        "veganBrands.js",
        "contentClassifier.js",
        "contextTopics.js",
        "webUnits.js",
        "adUnits.js",
        "people.js",
        "offers.js",
        "brandSites.js",
        "web.js"
      ],
      "css": [
        "web.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.google.com/search*",
        "*://*.bing.com/search*",
        "*://duckduckgo.com/*",
        "*://*.youtube.com/*",
        "*://*.amazon.com/s*",
        "*://*.pinterest.com/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.com.au/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.at/*",
        "*://*.pinterest.ch/*",
        "*://*.pinterest.ie/*",
        "*://*.pinterest.nz/*",
        "*://*.pinterest.pt/*",
        "*://*.pinterest.se/*",
        "*://*.pinterest.dk/*",
        "*://*.pinterest.jp/*",
        "*://*.pinterest.com.mx/*",
        "*://*.pinterest.cl/*",
        "*://*.pinterest.ph/*",
        "*://*.pinterest.co.kr/*",
        "*://*.ubereats.com/search*",
        "*://ubereats.com/search*",
        "*://*.ubereats.com/*/search*"
      ],
      "js": [
        "brand.js",
        "pageKey.js",
        "rules/rulesData.js",
        "rules/rules.js",
        "swaps.js",
        "searchRewrite.js",
        "search.js"
      ],
      "css": [
        "search.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.facebook.com/marketplace*"
      ],
      "js": [
        "brand.js",
        "pageKey.js",
        "rules/rulesData.js",
        "rules/rules.js",
        "share.js",
        "swaps.js",
        "veganBrands.js",
        "classifier.js",
        "adUnits.js",
        "marketplace.js"
      ],
      "css": [
        "marketplace.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "exclude_matches": [
        "*://*.facebook.com/marketplace*"
      ],
      "js": [
        "brand.js",
        "pageKey.js",
        "rules/rulesData.js",
        "rules/rules.js",
        "share.js",
        "swaps.js",
        "veganBrands.js",
        "classifier.js",
        "adUnits.js",
        "marketplace.js"
      ],
      "css": [
        "marketplace.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.sephora.com/product/*",
        "*://*.ulta.com/p/*",
        "*://*.walmart.com/ip/*",
        "*://*.target.com/p/*"
      ],
      "js": [
        "brand.js",
        "pageKey.js",
        "rules/rulesData.js",
        "rules/rules.js",
        "share.js",
        "swaps.js",
        "veganBrands.js",
        "classifier.js",
        "productdb.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
